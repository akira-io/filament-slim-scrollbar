{
    "name": "akira/filament-slim-scrollbar",
    "description": "This is my package filament-slim-scrollbar",
    "keywords": [
        "akira",
        "laravel",
        "filament-slim-scrollbar"
    ],
    "homepage": "https://github.com/akira/filament-slim-scrollbar",
    "support": {
        "issues": "https://github.com/akira/filament-slim-scrollbar/issues",
        "source": "https://github.com/akira/filament-slim-scrollbar"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "kid",
            "email": "kidiatoliny@akira-io.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "filament/filament": "^5.6.1",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9 || ^8.0",
        "nunomaduro/larastan": "^2.0.1 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0 || ^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.0 || ^2.0"
    },
    "suggest": {
        "akira/setup": "^1.3 - Development setup utilities (Laravel 12+ only)"
    },
    "autoload": {
        "psr-4": {
            "Akira\\FilamentSlimScrollbar\\": "src/",
            "Akira\\FilamentSlimScrollbar\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akira\\FilamentSlimScrollbar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:types": [
            "phpstan",
            "npm run test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Akira\\FilamentSlimScrollbar\\FilamentSlimScrollbarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
